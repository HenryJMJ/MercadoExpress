# =============================================
# MercadoExpress — Environment Variables Template
# =============================================

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- JWT ---
JWT_SECRET=your_jwt_secret_key_change_me
JWT_EXPIRES_IN=24h

# --- Auth Database (PostgreSQL) ---
AUTH_DB_HOST=auth-db
AUTH_DB_PORT=5432
AUTH_DB_USER=mercado_auth
AUTH_DB_PASSWORD=auth_secret_change_me
AUTH_DB_NAME=auth_db

# --- Catalog Database (PostgreSQL) ---
CATALOG_DB_HOST=catalog-db
CATALOG_DB_PORT=5432
CATALOG_DB_USER=mercado_catalog
CATALOG_DB_PASSWORD=catalog_secret_change_me
CATALOG_DB_NAME=catalog_db

# --- Orders Database (PostgreSQL) ---
ORDERS_DB_HOST=orders-db
ORDERS_DB_PORT=5432
ORDERS_DB_USER=mercado_orders
ORDERS_DB_PASSWORD=orders_secret_change_me
ORDERS_DB_NAME=orders_db

# --- Payments Database (PostgreSQL) ---
PAYMENTS_DB_HOST=payments-db
PAYMENTS_DB_PORT=5432
PAYMENTS_DB_USER=mercado_payments
PAYMENTS_DB_PASSWORD=payments_secret_change_me
PAYMENTS_DB_NAME=payments_db

# --- Tracking Database (PostgreSQL) ---
TRACKING_DB_HOST=tracking-db
TRACKING_DB_PORT=5432
TRACKING_DB_USER=mercado_tracking
TRACKING_DB_PASSWORD=tracking_secret_change_me
TRACKING_DB_NAME=tracking_db

# --- Analytics Database (PostgreSQL) ---
ANALYTICS_DB_HOST=analytics-db
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_USER=mercado_analytics
ANALYTICS_DB_PASSWORD=analytics_secret_change_me
ANALYTICS_DB_NAME=analytics_db

# --- Service Ports (internal, inside Docker network) ---
AUTH_PORT=4001
CATALOG_PORT=4002
ORDERS_PORT=4003
PAYMENTS_PORT=4004
TRACKING_PORT=4005
ANALYTICS_PORT=4006
GATEWAY_PORT=3000

